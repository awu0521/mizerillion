{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Same game with no database: an in-memory store and YOUR real bank (git-ignored).
  // Local play only; never deploy with this config. Use: npm run dev:bank
  "name": "mizerillion-bank-local",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-17",
  "alias": { "prompt-bank": "../bank_generation/data/prompt_bank.json" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "LOCAL_DEVELOPMENT": "true", "STORE": "memory" },
  "observability": { "enabled": true }
}
