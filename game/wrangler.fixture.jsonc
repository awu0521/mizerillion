{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Same game with no database: an in-memory store and the FAKE fixture bank.
  // Use: npm run dev:fixture
  "name": "mizerillion-fixture",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-17",
  "alias": { "prompt-bank": "./fixtures/sample_bank.json" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "LOCAL_DEVELOPMENT": "true", "STORE": "memory" },
  "observability": { "enabled": true }
}
