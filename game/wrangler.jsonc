{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare's name for the Worker. The in-game name lives in public/site.mjs.
  "name": "mizerillion",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-17",
  // run_worker_first: every request, assets included, goes through the Worker first,
  // so security headers (and, from milestone 3, the password gate) apply everywhere.
  // The deployed Worker bundles no prompt bank (the data is in Supabase).
  "alias": { "prompt-bank": "./src/empty_bank.json", "fake-members": "./src/empty_members.json" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Data lives in Supabase. Secrets (never in this file, never sent to the browser):
  //   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, PLAYER_PASSWORD_HASH, ADMIN_PASSWORD_HASH
  // Locally they come from .dev.vars; in production from `wrangler secret put` (npm run secrets).
  // This file is the production config: npm run deploy uses it. npm run dev adds LOCAL_DEVELOPMENT.
  "observability": { "enabled": true }
}
