{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare's name for the Worker. The in-game name lives in public/site.mjs.
  "name": "mizerillion",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-17",
  // The real prompt bank (git-ignored, never committed). It is bundled into the server-side
  // Worker only. To run without it, use wrangler.fixture.jsonc (fake bank) instead.
  "alias": { "prompt-bank": "../bank_generation/data/prompt_bank.json" },
  // run_worker_first: every request, assets included, goes through the Worker first,
  // so security headers (and, from milestone 3, the password gate) apply everywhere.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "LOCAL_DEVELOPMENT": "true" },
  "observability": { "enabled": true }
}
